#include <stdio.h>
int main(void){
	int n=8;
	int num[8]={};
	for(int cnt=0;cnt<n;cnt++){
		scanf("%d",&num[cnt]);
	}
	int tran;
	for(int i=0;i<n-1;i++){
		for(int j=0;j<7-i;j++){
			if(num[j]>num[j+1]){
				tran=num[j];
				num[j]=num[j+1];
				num[j+1]=tran;
			}
		}
	}
	for(int cnt=0;cnt<n;cnt++){
		printf("%d ",num[cnt]);
	}
	return 0;
}
